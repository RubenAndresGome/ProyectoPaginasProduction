# Copiar a .env (setup_windows.ps1 lo hace solo). NUNCA commitear .env.
DEBUG=True
SECRET_KEY=cambiar-por-clave-generada
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Desarrollo (Windows/Linux sin MySQL): SQLite, ruta relativa a BASE_DIR
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- MySQL (descomentar y comentar el bloque SQLite)

#!/bin/sh
# Hook pre-commit: bloquea el commit si hay llaves, contraseñas o archivos sensibles.
# Se activa una vez con:  git config core.hooksPath adminExe/hooks
# (Git para Windows también lo ejecuta con su sh incluido.)
raiz="$(git rev-parse --show-toplevel)"
for py in "$raiz/.venv/Scripts/python.exe" "$raiz/.venv/bin/python" python3 python py; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then
    exec "$py" "$raiz/adminExe/escanear_secretos.py" --staged
  fi
done
echo "pre-commit: no encontré Python para revisar secretos; commit bloqueado por seguridad." >&2
exit 1
